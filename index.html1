<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Roblox Account Check</title>
    <style>
        body { font-family: sans-serif; background: #1b1d1f; color: white; text-align: center; padding: 20px; }
        .box { background: #2a2d30; padding: 20px; border-radius: 15px; max-width: 400px; margin: auto; }
        input { width: 80%; padding: 10px; border-radius: 5px; border: none; margin-bottom: 10px; }
        button { padding: 10px 20px; background: #00a2ff; border: none; color: white; border-radius: 5px; font-weight: bold; }
        #result { margin-top: 20px; text-align: left; background: #333; padding: 10px; border-radius: 8px; display: none; }
        .avatar { width: 100px; height: 100px; border-radius: 50%; background: #444; margin-bottom: 10px; }
    </style>
</head>
<body>

<div class="box">
    <h2>Kiểm tra ID Roblox</h2>
    <input type="number" id="userId" placeholder="Nhập ID người dùng (VD: 1)">
    <br>
    <button onclick="checkAcc()">Kiểm tra ngay</button>

    <div id="result">
        <center><img id="userThumb" class="avatar" src=""></center>
        <p><b>Tên:</b> <span id="uName"></span></p>
        <p><b>Tên hiển thị:</b> <span id="uDisplayName"></span></p>
        <p><b>Ngày tạo:</b> <span id="uCreated"></span></p>
        <p><b>Trạng thái:</b> <span id="uStatus"></span></p>
    </div>
</div>

<script>
async function checkAcc() {
    const id = document.getElementById('userId').value;
    const resDiv = document.getElementById('result');
    if(!id) return alert("Vui lòng nhập ID!");

    try {
        // Gọi API lấy thông tin cơ bản
        const proxy = "https://corsproxy.io/?";
        const userRes = await fetch(`${proxy}https://users.roblox.com/v1/users/${id}`);
        const userData = await userRes.json();

        if(userData.errors) {
            alert("Không tìm thấy tài khoản này!");
            return;
        }

        // Gọi API lấy ảnh đại diện
        const thumbRes = await fetch(`${proxy}https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=${id}&size=150x150&format=Png&isCircular=false`);
        const thumbData = await thumbRes.json();

        // Hiển thị dữ liệu
        document.getElementById('uName').innerText = userData.name;
        document.getElementById('uDisplayName').innerText = userData.displayName;
        document.getElementById('uCreated').innerText = new Date(userData.created).toLocaleDateString();
        document.getElementById('uStatus').innerText = userData.isBanned ? "Đã bị BAN ❌" : "Hoạt động ✅";
        document.getElementById('userThumb').src = thumbData.data[0].imageUrl;
        
        resDiv.style.display = "block";
    } catch (err) {
        alert("Lỗi kết nối API!");
    }
}
</script>

</body>
</html>
